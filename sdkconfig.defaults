# Wartości potwierdzone na tym egzemplarzu płytki — patrz
# docs/hardware/verified-board-map.md. Nie luzować bez testu na sprzęcie.

CONFIG_IDF_TARGET="esp32p4"

# Flash: 16 MB, QIO 80 MHz (producent Boya, IDF używa sterownika ogólnego)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# PSRAM: 32 MB w trybie HEX, 200 MHz
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# Ekran 480 x 800 ST7701 przez MIPI-DSI. Mylące nazwy opcji BSP wyjaśnia
# components/README.md: ta gałąź to właśnie ST7701 480 x 800.
CONFIG_BSP_LCD_TYPE_1024_600=y
CONFIG_BSP_LCD_COLOR_FORMAT_RGB565=y
# Jeden bufor ramki i częściowy bufor LVGL — taki układ potwierdzono przy bring-upie.
CONFIG_BSP_LCD_DPI_BUFFER_NUMS=1
# Orientacja pozioma (Ekran → Orientacja) obraca każdy fragment ramki procesorem.
# PPA wyłączone: z nim pilot zawieszał się przy przewijaniu w poziomie — zadanie LVGL
# czekało na PPA z trzymaną blokadą (ADR 0013). W pionie obrotu nie ma wcale.
CONFIG_LVGL_PORT_ENABLE_PPA=n

# LVGL 9.2.2
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_USE_PERF_MONITOR=n
CONFIG_LV_USE_MEM_MONITOR=n
CONFIG_LV_DEF_REFR_PERIOD=16
CONFIG_LV_FONT_MONTSERRAT_14=n
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_14=n

# C++17 bez wyjątków i RTTI — kod aplikacji ich nie używa.
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n
CONFIG_COMPILER_OPTIMIZATION_PERF=y

CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Przykłady i dema LVGL tylko wydłużają budowanie — projekt ich nie używa.
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_BUILD_DEMOS=n

# Bez motywu domyślnego LVGL: jedynym źródłem wyglądu jest ui/theme.
CONFIG_LV_USE_THEME_DEFAULT=n
CONFIG_LV_USE_THEME_SIMPLE=n

# Montserrat zostaje wyłącznie jako źródło wbudowanych symboli LVGL
# (strzałki, zasilanie, głośność). Tekst rysuje Ubuntu.
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y

# Pamięć LVGL. Wbudowana pula ma 64 kB i pięć ekranów Pulpitu jej nie mieszczą;
# przy przepełnieniu alokator LVGL nie zgłasza błędu, tylko zapętla się w szukaniu
# wolnego bloku. Własny alokator (components/board/lv_mem_psram.c) kładzie obiekty
# wprost w PSRAM: zwykły malloc trzymał każdy do 4 kB w pamięci wewnętrznej.
CONFIG_LV_USE_CUSTOM_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_SPIRAM_USE_MALLOC=y

# Limit odczytu esp-mqtt zostaje domyślny (1000 ms). Kiedyś był 20 ms, żeby kolejka
# `enqueue` nie czekała sekundę na obieg pętli (klawisze Apple TV szły co sekundę),
# ale tak krótki limit zrywał połączenie przy każdej przerwie dłuższej niż 20 ms
# w środku dużej wiadomości. Polecenia wysyła teraz własne zadanie MqttBus wprost
# przez publish, więc kolejka biblioteki nie stoi na drodze.
CONFIG_MQTT_USE_CUSTOM_CONFIG=y
CONFIG_MQTT_POLL_READ_TIMEOUT_MS=1000

# Zapas stosu każdego zadania w logu pomiaru pamięci (core/memory). Koszt: kilka bajtów
# na zadanie i funkcja uxTaskGetSystemState.
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
