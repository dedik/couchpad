# Wzór konfiguracji dla publish-update.sh. Skopiuj do update.env (poza gitem) i uzupełnij.

# Konto SSH na serwerze z Home Assistantem i opcjonalny klucz.
UPDATE_SSH=root@nas.local
UPDATE_SSH_KEY=~/.ssh/id_ed25519

# Katalog `www/pilot` w konfiguracji Home Assistanta (widoczny jako /local/pilot).
# Katalog `www` musi istnieć przy starcie HA, inaczej /local nie działa do restartu.
UPDATE_WWW_DIR=/config/www/pilot

# Adres, pod którym telefony pobiorą APK.
UPDATE_BASE_URL=http://homeassistant.local:8123/local/pilot

# Home Assistant do publikacji manifestu przez mqtt.publish.
HA_URL=http://homeassistant.local:8123
# Polecenie wypisujące długoterminowy token HA (nie wpisuj tokenu wprost).
HA_TOKEN_CMD="security find-generic-password -s home-assistant -a api-token -w"
